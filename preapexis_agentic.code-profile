{
  "name": "PreApeXis Agentic",
  "settings": "{\"settings\":\"// PreApeXis Agentic \\u2014 calm, dense terminal-first profile\\n{\\n  // Appearance and layout\\n  \\\"workbench.colorTheme\\\": \\\"Catppuccin Mocha\\\",\\n  \\\"workbench.iconTheme\\\": \\\"symbols\\\",\\n  \\\"catppuccin.accentColor\\\": \\\"mauve\\\",\\n  \\\"catppuccin.workbenchMode\\\": \\\"flat\\\",\\n  \\\"catppuccin.bracketMode\\\": \\\"rainbow\\\",\\n  \\\"catppuccin.italicComments\\\": true,\\n  \\\"catppuccin.boldKeywords\\\": false,\\n  \\\"workbench.startupEditor\\\": \\\"none\\\",\\n  \\\"workbench.list.smoothScrolling\\\": true,\\n  \\\"workbench.sideBar.location\\\": \\\"right\\\",\\n  \\\"workbench.activityBar.location\\\": \\\"top\\\",\\n  \\\"workbench.editor.enablePreview\\\": true,\\n  \\\"workbench.editor.closeOnFileDelete\\\": false,\\n  \\\"workbench.editor.wrapTabs\\\": false,\\n  \\\"workbench.panel.defaultLocation\\\": \\\"bottom\\\",\\n  \\\"workbench.panel.opensMaximized\\\": \\\"never\\\",\\n  \\\"explorer.compactFolders\\\": false,\\n  \\\"explorer.fileNesting.enabled\\\": true,\\n  \\\"explorer.fileNesting.expand\\\": false,\\n  \\\"explorer.fileNesting.patterns\\\": {\\n    \\\"*.ts\\\": \\\"${capture}.js\\\",\\n    \\\"*.js\\\": \\\"${capture}.js.map, ${capture}.min.js, ${capture}.d.ts\\\",\\n    \\\"*.jsx\\\": \\\"${capture}.js\\\",\\n    \\\"*.tsx\\\": \\\"${capture}.ts\\\",\\n    \\\"tsconfig.json\\\": \\\"tsconfig.*.json\\\",\\n    \\\"package.json\\\": \\\"package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock\\\",\\n    \\\"pubspec.yaml\\\": \\\"pubspec.lock, pubspec_overrides.yaml, .packages, .flutter-plugins, .flutter-plugins-dependencies, .metadata\\\",\\n    \\\"*.dart\\\": \\\"${capture}.g.dart\\\",\\n    \\\"*.sqlite\\\": \\\"${capture}.${extname}-*\\\",\\n    \\\"*.db\\\": \\\"${capture}.${extname}-*\\\",\\n    \\\"*.sqlite3\\\": \\\"${capture}.${extname}-*\\\",\\n    \\\"*.db3\\\": \\\"${capture}.${extname}-*\\\",\\n    \\\"*.sdb\\\": \\\"${capture}.${extname}-*\\\",\\n    \\\"*.s3db\\\": \\\"${capture}.${extname}-*\\\"\\n  },\\n  \\\"breadcrumbs.enabled\\\": true,\\n\\n  // Editor\\n  \\\"editor.fontFamily\\\": \\\"'JetBrainsMono Nerd Font', 'JetBrains Mono', 'Cascadia Code', monospace\\\",\\n  \\\"editor.fontSize\\\": 15,\\n  \\\"editor.fontLigatures\\\": true,\\n  \\\"editor.lineHeight\\\": 1.4,\\n  \\\"editor.tabSize\\\": 2,\\n  \\\"editor.insertSpaces\\\": true,\\n  \\\"editor.detectIndentation\\\": true,\\n  \\\"editor.wordWrap\\\": \\\"bounded\\\",\\n  \\\"editor.wordWrapColumn\\\": 100,\\n  \\\"editor.hover.delay\\\": 500,\\n  \\\"editor.cursorBlinking\\\": \\\"phase\\\",\\n  \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n  \\\"editor.smoothScrolling\\\": true,\\n  \\\"editor.renderLineHighlight\\\": \\\"gutter\\\",\\n  \\\"editor.linkedEditing\\\": true,\\n  \\\"editor.suggestSelection\\\": \\\"first\\\",\\n  \\\"editor.acceptSuggestionOnEnter\\\": \\\"smart\\\",\\n  \\\"editor.formatOnSave\\\": true,\\n  \\\"editor.formatOnPaste\\\": false,\\n  \\\"editor.minimap.enabled\\\": false,\\n  \\\"editor.renderWhitespace\\\": \\\"selection\\\",\\n  \\\"editor.scrollbar.vertical\\\": \\\"auto\\\",\\n  \\\"editor.stickyScroll.enabled\\\": true,\\n  \\\"editor.stickyScroll.maxLineCount\\\": 5,\\n  \\\"editor.inlayHints.enabled\\\": \\\"onUnlessPressed\\\",\\n  \\\"editor.bracketPairColorization.enabled\\\": true,\\n  \\\"editor.guides.bracketPairs\\\": true,\\n  \\\"editor.formatOnSaveMode\\\": \\\"modificationsIfAvailable\\\",\\n\\n  // Terminal: editor area maximizes rows and keeps TUI sessions beside code\\n  \\\"terminal.integrated.defaultLocation\\\": \\\"editor\\\",\\n  \\\"terminal.integrated.fontFamily\\\": \\\"'JetBrainsMono Nerd Font', 'JetBrains Mono', 'Cascadia Code', monospace\\\",\\n  \\\"terminal.integrated.fontSize\\\": 15,\\n  \\\"terminal.integrated.lineHeight\\\": 1.1,\\n  \\\"terminal.integrated.customGlyphs\\\": true,\\n  \\\"terminal.integrated.minimumContrastRatio\\\": 1,\\n  \\\"terminal.integrated.cursorBlinking\\\": true,\\n  \\\"terminal.integrated.smoothScrolling\\\": true,\\n  \\\"terminal.integrated.scrollback\\\": 50000,\\n  \\\"terminal.integrated.shellIntegration.enabled\\\": true,\\n  \\\"terminal.integrated.enablePersistentSessions\\\": true,\\n  \\\"terminal.integrated.defaultProfile.windows\\\": \\\"PowerShell\\\",\\n  \\\"terminal.integrated.profiles.windows\\\": {\\n    \\\"PowerShell\\\": {\\n      \\\"source\\\": \\\"PowerShell\\\",\\n      \\\"icon\\\": \\\"terminal-powershell\\\"\\n    },\\n    \\\"Command Prompt\\\": {\\n      \\\"path\\\": [\\n        \\\"${env:windir}\\\\\\\\Sysnative\\\\\\\\cmd.exe\\\",\\n        \\\"${env:windir}\\\\\\\\System32\\\\\\\\cmd.exe\\\"\\n      ],\\n      \\\"args\\\": [],\\n      \\\"icon\\\": \\\"terminal-cmd\\\"\\n    },\\n    \\\"Git Bash\\\": {\\n      \\\"source\\\": \\\"Git Bash\\\"\\n    },\\n    \\\"Claude Code\\\": {\\n      \\\"source\\\": \\\"PowerShell\\\",\\n      \\\"args\\\": [\\\"-NoLogo\\\", \\\"-NoExit\\\", \\\"-Command\\\", \\\"claude\\\"],\\n      \\\"icon\\\": \\\"hubot\\\",\\n      \\\"color\\\": \\\"terminal.ansiMagenta\\\"\\n    },\\n    \\\"Codex CLI\\\": {\\n      \\\"source\\\": \\\"PowerShell\\\",\\n      \\\"args\\\": [\\\"-NoLogo\\\", \\\"-NoExit\\\", \\\"-Command\\\", \\\"codex\\\"],\\n      \\\"icon\\\": \\\"sparkle\\\",\\n      \\\"color\\\": \\\"terminal.ansiGreen\\\"\\n    },\\n    \\\"pi\\\": {\\n      \\\"source\\\": \\\"PowerShell\\\",\\n      \\\"args\\\": [\\\"-NoLogo\\\", \\\"-NoExit\\\", \\\"-Command\\\", \\\"pi\\\"],\\n      \\\"icon\\\": \\\"terminal\\\",\\n      \\\"color\\\": \\\"terminal.ansiBlue\\\"\\n    }\\n  },\\n\\n  // Files and external-agent churn\\n  \\\"files.autoSave\\\": \\\"onFocusChange\\\",\\n  \\\"files.trimTrailingWhitespace\\\": true,\\n  \\\"files.insertFinalNewline\\\": true,\\n  \\\"files.trimFinalNewlines\\\": true,\\n  \\\"files.exclude\\\": {\\n    \\\"**/.git\\\": true,\\n    \\\"**/.DS_Store\\\": true,\\n    \\\"**/node_modules\\\": true,\\n    \\\"**/.dart_tool\\\": true,\\n    \\\"**/.flutter-plugins\\\": true,\\n    \\\"**/.flutter-plugins-dependencies\\\": true,\\n    \\\"**/.metadata\\\": true\\n  },\\n  \\\"search.exclude\\\": {\\n    \\\"**/node_modules\\\": true,\\n    \\\"**/dist\\\": true,\\n    \\\"**/build\\\": true,\\n    \\\"**/.dart_tool\\\": true,\\n    \\\"**/.claude/worktrees\\\": true\\n  },\\n  \\\"files.watcherExclude\\\": {\\n    \\\"**/node_modules/**\\\": true,\\n    \\\"**/dist/**\\\": true,\\n    \\\"**/build/**\\\": true,\\n    \\\"**/.dart_tool/**\\\": true\\n  },\\n  \\\"search.useGlobalIgnoreFiles\\\": true,\\n\\n  // Review and diagnostics\\n  \\\"diffEditor.hideUnchangedRegions.enabled\\\": true,\\n  \\\"diffEditor.ignoreTrimWhitespace\\\": false,\\n  \\\"scm.defaultViewMode\\\": \\\"tree\\\",\\n  \\\"git.decorations.enabled\\\": true,\\n  \\\"gitlens.currentLine.enabled\\\": false,\\n  \\\"errorLens.enabled\\\": true,\\n  \\\"errorLens.enabledDiagnosticLevels\\\": [\\\"error\\\", \\\"warning\\\"],\\n  \\\"errorLens.statusBarMessageEnabled\\\": false,\\n\\n  // Language tooling and formatters (intentionally retained)\\n  \\\"[javascript]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.rulers\\\": [100],\\n    \\\"editor.codeActionsOnSave\\\": {\\\"source.fixAll.eslint\\\": \\\"explicit\\\"}\\n  },\\n  \\\"[javascriptreact]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.codeActionsOnSave\\\": {\\\"source.fixAll.eslint\\\": \\\"explicit\\\"}\\n  },\\n  \\\"[typescript]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.rulers\\\": [100],\\n    \\\"editor.codeActionsOnSave\\\": {\\\"source.fixAll.eslint\\\": \\\"explicit\\\"}\\n  },\\n  \\\"[typescriptreact]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"editor.codeActionsOnSave\\\": {\\\"source.fixAll.eslint\\\": \\\"explicit\\\"}\\n  },\\n  \\\"[json]\\\": {\\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"},\\n  \\\"[jsonc]\\\": {\\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"},\\n  \\\"[html]\\\": {\\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"},\\n  \\\"[css]\\\": {\\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"},\\n  \\\"[tailwindcss]\\\": {\\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"},\\n  \\\"[prisma]\\\": {\\\"editor.defaultFormatter\\\": \\\"Prisma.prisma\\\"},\\n  \\\"[github-actions-workflow]\\\": {\\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"},\\n  \\\"[markdown]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n    \\\"files.trimTrailingWhitespace\\\": false\\n  },\\n  \\\"[dart]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"Dart-Code.dart-code\\\",\\n    \\\"editor.formatOnType\\\": true,\\n    \\\"editor.rulers\\\": [80],\\n    \\\"editor.selectionHighlight\\\": false,\\n    \\\"editor.tabCompletion\\\": \\\"onlySnippets\\\",\\n    \\\"editor.wordBasedSuggestions\\\": \\\"off\\\"\\n  },\\n  \\\"dart.showInspectorNotificationsForWidgetErrors\\\": false,\\n  \\\"dart.debugExternalPackageLibraries\\\": false,\\n  \\\"dart.debugSdkLibraries\\\": false,\\n  \\\"js/ts.updateImportsOnFileMove.enabled\\\": \\\"always\\\",\\n  \\\"js/ts.preferences.importModuleSpecifier\\\": \\\"relative\\\",\\n  \\\"js/ts.inlayHints.parameterNames.enabled\\\": \\\"literals\\\",\\n  \\\"notebook.formatOnSave.enabled\\\": true,\\n  \\\"prettier.requireConfig\\\": true,\\n\\n  // UI-only guardrails (do not constrain CLI agents)\\n  \\\"git.allowForcePush\\\": false,\\n  \\\"git.branchProtection\\\": [\\\"main\\\", \\\"master\\\"],\\n  \\\"git.branchProtectionPrompt\\\": \\\"alwaysCommitToNewBranch\\\",\\n  \\\"chat.agent.maxRequests\\\": 50,\\n  \\\"chat.tools.terminal.autoApprove\\\": {\\n    \\\"git status\\\": true,\\n    \\\"git diff\\\": true,\\n    \\\"git log\\\": true,\\n    \\\"npm test\\\": true,\\n    \\\"npm run lint\\\": true,\\n    \\\"git push\\\": false,\\n    \\\"rm\\\": false\\n  },\\n\\n  // Misc / tooling\\n  \\\"git.confirmSync\\\": true,\\n  \\\"git.enableSmartCommit\\\": false,\\n  \\\"git.autofetch\\\": true,\\n  \\\"git.openRepositoryInParentFolders\\\": \\\"prompt\\\",\\n  \\\"remote.autoForwardPortsSource\\\": \\\"hybrid\\\",\\n  \\\"security.workspace.trust.enabled\\\": true,\\n  \\\"telemetry.telemetryLevel\\\": \\\"off\\\",\\n  \\\"liveServer.settings.donotShowInfoMsg\\\": true,\\n  \\\"rest-client.largeResponseBodySizeLimitInMB\\\": 10,\\n  \\\"rest-client.disableAddingHrefLinkForLargeResponse\\\": false,\\n  \\\"json.schemaDownload.trustedDomains\\\": {\\n    \\\"https://developer.microsoft.com/json-schemas/\\\": true,\\n    \\\"https://json-schema.org/\\\": true,\\n    \\\"https://json.schemastore.org/\\\": true,\\n    \\\"https://raw.githubusercontent.com/devcontainers/spec/\\\": true,\\n    \\\"https://raw.githubusercontent.com/microsoft/vscode/\\\": true,\\n    \\\"https://schemastore.azurewebsites.net/\\\": true,\\n    \\\"https://www.schemastore.org/\\\": true\\n  }\\n}\\n\"}",
  "keybindings": "{\"keybindings\":\"[\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+s\\\",\\n    \\\"command\\\": \\\"-workbench.action.files.saveAs\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+shift+s\\\",\\n    \\\"command\\\": \\\"-workbench.action.files.saveAs\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+s\\\",\\n    \\\"command\\\": \\\"workbench.action.files.saveFiles\\\",\\n    \\\"when\\\": \\\"!isMac\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+shift+s\\\",\\n    \\\"command\\\": \\\"workbench.action.files.saveFiles\\\",\\n    \\\"when\\\": \\\"isMac\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+3\\\",\\n    \\\"command\\\": \\\"workbench.action.files.saveAs\\\",\\n    \\\"when\\\": \\\"!isMac\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+alt+shift+s\\\",\\n    \\\"command\\\": \\\"workbench.action.files.saveAs\\\",\\n    \\\"when\\\": \\\"isMac\\\"\\n  }\\n]\\n\"}",
  "tasks": "{\"tasks\":\"{}\"}",
  "snippets": "{\"snippets\":{\"react-boilerplate.code-snippets\":\"{\\n  \\\"react-boiler-plate\\\": {\\n    \\\"scope\\\": \\\"javascriptreact,typescriptreact\\\",\\n    \\\"prefix\\\": \\\"cfr\\\",\\n    \\\"body\\\": [\\n      \\\"export default function ${1:App}() {\\\",\\n      \\\"  return <div>$0</div>;\\\",\\n      \\\"}\\\"\\n    ],\\n    \\\"description\\\": \\\"Create a React function component\\\"\\n  }\\n}\\n\"}}",
